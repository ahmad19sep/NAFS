# ─── NATIVE APP (Expo) ────────────────────────────────────────────────────────
# Supabase — Project Settings > API on supabase.com
# Expo requires EXPO_PUBLIC_ prefix for client-side env vars
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Vercel backend URL — the deployed web-legacy Next.js app that hosts AI routes
EXPO_PUBLIC_API_BASE_URL=https://your-nafs-app.vercel.app

# ─── WEB BACKEND (web-legacy / Vercel) ───────────────────────────────────────
# Keep these in web-legacy/.env.local for the Next.js backend
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
GEMINI_API_KEY=your-gemini-api-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:ahmadsiddique665@gmail.com
NEXT_PUBLIC_APP_URL=https://your-nafs-app.vercel.app
CRON_SECRET=
RESEND_API_KEY=
NAFS_EMAIL_FROM=NAFS <noreply@yourdomain.com>
GROQ_API_KEY=
