{
  "root": true,
  "extends": "expo",
  "ignorePatterns": ["web-legacy/**", "android/**", "android-capacitor-legacy/**", "capacitor.config.ts", "output/**"],
  "overrides": [
    { "files": ["scripts/**/*.js", "public/icons/**/*.js", "*.config.js"], "env": { "node": true } },
    { "files": ["public/sw.js"], "env": { "browser": true, "serviceworker": true } }
  ]
}
